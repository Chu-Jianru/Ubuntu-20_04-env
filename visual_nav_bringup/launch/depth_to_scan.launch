<launch>
  <!-- 把对齐后的深度图中间一条转成 /scan，供代价地图避障。 -->
  <arg name="camera_name" default="camera"/>
  <arg name="range_min" default="0.30"/>
  <arg name="range_max" default="4.0"/>
  <arg name="scan_height" default="10"/>

  <node pkg="depthimage_to_laserscan" type="depthimage_to_laserscan" name="depthimage_to_laserscan" output="screen">
    <remap from="image" to="/$(arg camera_name)/aligned_depth_to_color/image_raw"/>
    <remap from="camera_info" to="/$(arg camera_name)/aligned_depth_to_color/camera_info"/>
    <remap from="scan" to="/scan"/>
    <param name="range_min" type="double" value="$(arg range_min)"/>
    <param name="range_max" type="double" value="$(arg range_max)"/>
    <param name="scan_height" type="int" value="$(arg scan_height)"/>
    <param name="scan_time" type="double" value="0.033"/>
  </node>
</launch>
